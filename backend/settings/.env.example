# Avoid a bare "$" followed by letters in any value here: docker-compose
# interpolates env_file contents, so e.g. "$q" silently turns into "" inside
# the container. Use "$$" if you ever need a literal "$" in a real secret.
PROJECT_SECRET_KEY=django-insecure-#^1huub9p)p-gzi=jm6jc29%riogb1f(g%#)^*=-@!3%3ou7b4
PROJECT_ENV_ID=dev

POSTGRES_DB=quickskill
POSTGRES_USER=quickskill
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to make cross-origin requests to the API (comma-separated).
# Read by backend/settings/conf.py; defaults to the two values below if unset,
# but on a real deployment you almost certainly need to override this.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
